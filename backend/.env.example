PORT=8080
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/expensify
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=7d

# Used to build the link inside password-reset emails (your deployed frontend URL)
FRONT_END_URL=http://localhost:5173

# Gmail SMTP (EMAIL_PASS must be a Gmail App Password, not your normal password)
EMAIL_USER=your@email.com
EMAIL_PASS=your_gmail_app_password

# Razorpay (premium upgrade payment flow)
RAZOR_PAY_KEY=your_razorpay_key_id
RAZOR_PAY_SECRET=your_razorpay_key_secret

# Cloudinary (CSV export storage)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret
